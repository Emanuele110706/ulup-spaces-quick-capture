{
  "manifest_version": 3,
  "name": "UluP Spaces — Quick Capture",
  "version": "1.0.0",
  "description": "Save any web page as a node in one of your UluP Spaces projects, in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://ulupspaces.com/*", "https://www.ulupspaces.com/*"]
}
